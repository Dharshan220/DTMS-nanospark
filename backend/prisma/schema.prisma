generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FACULTY
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ProfileStatus {
  ACTIVE
  INACTIVE
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum BusStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum AssignmentStatus {
  ACTIVE
  INACTIVE
}

enum TripType {
  MORNING
  EVENING
}

enum ComplaintCategory {
  BUS
  DRIVER
  ROUTE
  BUS_STOP
  ATTENDANCE
  SAFETY
  OTHER
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum FeedbackCategory {
  BUS
  ROUTE
  DRIVER
  FACULTY
  SERVICE
  OTHER
}

enum FeedbackStatus {
  SUBMITTED
  REVIEWED
  RESOLVED
}

enum EmergencyType {
  MEDICAL
  ACCIDENT
  SAFETY
  BREAKDOWN
  HARASSMENT
  SECURITY
  OTHER
}

enum EmergencyPriority {
  CRITICAL
  HIGH
  MEDIUM
}

enum EmergencyStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  CANCELLED
}

enum NotificationChannel {
  WHATSAPP
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum NotificationType {
  EMERGENCY
  COMPLAINT
  FEEDBACK
  TRANSPORT
  SYSTEM
}

enum ScheduleStatus {
  ACTIVE
  INACTIVE
  CANCELLED
}

enum ScheduleOverrideStatus {
  SCHEDULED
  CANCELLED
  REPLACED
}

enum TransportEventType {
  BUS_ASSIGNED
  BUS_SWAPPED
  BUS_REPLACED
  BUS_CANCELLED
  ROUTE_CHANGED
  BUS_STOP_CHANGED
  TRANSPORT_ANNOUNCEMENT
  SCHEDULE_CREATED
  SCHEDULE_CHANGED
  SCHEDULE_TIME_CHANGED
  TRIP_CANCELLED
  BUS_REPLACED_SCHEDULE
}

enum TransportNotificationTarget {
  ALL_STUDENTS
  ALL_FACULTY
  ALL_USERS
  SPECIFIC_BUS
  SPECIFIC_ROUTE
  SPECIFIC_STUDENTS
  SPECIFIC_FACULTY
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         Role
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  lastLoginAt  DateTime?  @map("last_login_at")

  student  Student?
  faculty  Faculty?
  emergencyAlerts EmergencyAlert[]
  notifications  Notification[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Student {
  id              String        @id @default(uuid())
  userId          String        @unique @map("user_id")
  registerNumber  String        @unique @map("register_number")
  name            String
  phone           String?
  department      String?
  year            String?
  section         String?
  gender          String?
  status          ProfileStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transportAssignment StudentBusAssignment?
  complaints          Complaint[]
  feedback            Feedback[]
  emergencyAlerts     EmergencyAlert[]

  @@index([userId])
  @@index([registerNumber])
  @@index([name])
  @@index([department])
  @@map("students")
}

model Faculty {
  id          String        @id @default(uuid())
  userId      String        @unique @map("user_id")
  facultyId   String        @unique @map("faculty_id")
  name        String
  phone       String?
  department  String?
  designation String?
  status      ProfileStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transportAssignment FacultyBusAssignment?
  attendances         Attendance[]
  emergencyAlerts     EmergencyAlert[]

  @@index([userId])
  @@index([facultyId])
  @@index([name])
  @@index([department])
  @@map("faculty")
}

model Driver {
  id              String       @id @default(uuid())
  driverCode      String       @unique @map("driver_code")
  name            String
  phone           String?
  alternatePhone  String?      @map("alternate_phone")
  licenseNumber   String       @unique @map("license_number")
  licenseExpiry   DateTime?    @map("license_expiry")
  experienceYears Int?         @map("experience_years")
  address         String?
  status          DriverStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  bus        Bus?
  complaints Complaint[]

  @@index([driverCode])
  @@index([name])
  @@index([phone])
  @@index([licenseNumber])
  @@map("drivers")
}

model Bus {
  id                 String     @id @default(uuid())
  busNumber          Int        @unique @map("bus_number")
  registrationNumber String     @unique @map("registration_number")
  capacity           Int        @default(60)
  boysCapacity       Int?       @map("boys_capacity")
  girlsCapacity      Int?       @map("girls_capacity")
  driverId           String?    @unique @map("driver_id")
  routeId            String?    @map("route_id")
  status             BusStatus  @default(ACTIVE)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  driver             Driver?                @relation(fields: [driverId], references: [id], onDelete: SetNull)
  route              Route?                 @relation(fields: [routeId], references: [id], onDelete: SetNull)
  studentAssignments StudentBusAssignment[]
  facultyAssignments FacultyBusAssignment[]
  attendances        Attendance[]
  complaints         Complaint[]
  emergencyAlerts    EmergencyAlert[]
  transportSchedules TransportSchedule[]
  scheduleOverrides  ScheduleOverride[]

  @@index([busNumber])
  @@index([registrationNumber])
  @@index([driverId])
  @@index([routeId])
  @@index([status])
  @@map("buses")
}

model Route {
  id          String       @id @default(uuid())
  routeCode   String       @unique @map("route_code")
  routeName   String       @map("route_name")
  description String?
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  buses      Bus[]
  routeStops RouteStop[]
  complaints Complaint[]
  emergencyAlerts EmergencyAlert[]
  transportSchedules TransportSchedule[]

  @@index([routeCode])
  @@index([routeName])
  @@map("routes")
}

model BusStop {
  id        String       @id @default(uuid())
  stopCode  String       @unique @map("stop_code")
  name      String
  address   String?
  latitude  Float?
  longitude Float?
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  routeStops          RouteStop[]
  studentAssignments  StudentBusAssignment[]
  complaints          Complaint[]

  @@index([stopCode])
  @@index([name])
  @@map("bus_stops")
}

model RouteStop {
  id                    String   @id @default(uuid())
  routeId               String   @map("route_id")
  busStopId             String   @map("bus_stop_id")
  stopOrder             Int      @map("stop_order")
  estimatedArrivalTime  String?  @map("estimated_arrival_time")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  route   Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  busStop BusStop @relation(fields: [busStopId], references: [id], onDelete: Cascade)

  @@unique([routeId, busStopId])
  @@unique([routeId, stopOrder])
  @@index([routeId])
  @@index([busStopId])
  @@map("route_stops")
}

model StudentBusAssignment {
  id         String           @id @default(uuid())
  studentId  String           @unique @map("student_id")
  busId      String           @map("bus_id")
  busStopId  String           @map("bus_stop_id")
  startDate  DateTime         @default(now()) @map("start_date")
  endDate    DateTime?        @map("end_date")
  status     AssignmentStatus @default(ACTIVE)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bus     Bus     @relation(fields: [busId], references: [id], onDelete: Cascade)
  busStop BusStop @relation(fields: [busStopId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([busId])
  @@index([busStopId])
  @@index([status])
  @@map("student_bus_assignments")
}

model FacultyBusAssignment {
  id         String           @id @default(uuid())
  facultyId  String           @unique @map("faculty_id")
  busId      String           @map("bus_id")
  startDate  DateTime         @default(now()) @map("start_date")
  endDate    DateTime?        @map("end_date")
  status     AssignmentStatus @default(ACTIVE)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  bus     Bus     @relation(fields: [busId], references: [id], onDelete: Cascade)

  @@index([facultyId])
  @@index([busId])
  @@index([status])
  @@map("faculty_bus_assignments")
}

model Attendance {
  id         String   @id @default(uuid())
  busId      String   @map("bus_id")
  facultyId  String   @map("faculty_id")
  date       DateTime @map("date")
  tripType   TripType @map("trip_type")
  boysCount  Int      @default(0) @map("boys_count")
  girlsCount Int      @default(0) @map("girls_count")
  totalCount Int      @default(0) @map("total_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  bus    Bus    @relation(fields: [busId], references: [id], onDelete: Cascade)
  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([busId, date, tripType])
  @@index([busId])
  @@index([facultyId])
  @@index([date])
  @@index([tripType])
  @@map("attendance")
}

model Complaint {
  id             String             @id @default(uuid())
  studentId      String             @map("student_id")
  subject        String
  description    String
  category       ComplaintCategory
  priority       ComplaintPriority  @default(MEDIUM)
  status         ComplaintStatus    @default(OPEN)
  busId          String?            @map("bus_id")
  driverId       String?            @map("driver_id")
  routeId        String?            @map("route_id")
  busStopId      String?            @map("bus_stop_id")
  resolutionNote String?            @map("resolution_note")
  resolvedAt     DateTime?          @map("resolved_at")
  resolvedBy     String?            @map("resolved_by")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bus     Bus?    @relation(fields: [busId], references: [id], onDelete: SetNull)
  driver  Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)
  route   Route?  @relation(fields: [routeId], references: [id], onDelete: SetNull)
  busStop BusStop? @relation(fields: [busStopId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([createdAt])
  @@index([busId])
  @@index([driverId])
  @@index([routeId])
  @@index([busStopId])
  @@map("complaints")
}

model Feedback {
  id         String           @id @default(uuid())
  studentId  String           @map("student_id")
  subject    String
  message    String
  rating     Int
  category   FeedbackCategory
  status     FeedbackStatus   @default(SUBMITTED)
  reviewedAt DateTime?        @map("reviewed_at")
  reviewedBy String?          @map("reviewed_by")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
  @@index([category])
  @@index([rating])
  @@index([createdAt])
  @@map("feedback")
}

model EmergencyAlert {
  id               String             @id @default(uuid())
  userId           String             @map("user_id")
  role             Role
  studentId        String?            @map("student_id")
  facultyId        String?            @map("faculty_id")
  busId            String?            @map("bus_id")
  routeId          String?            @map("route_id")
  latitude         Float?
  longitude        Float?
  locationAccuracy Float?             @map("location_accuracy")
  message          String?
  type             EmergencyType
  priority         EmergencyPriority  @default(CRITICAL)
  status           EmergencyStatus    @default(ACTIVE)
  acknowledgedAt   DateTime?          @map("acknowledged_at")
  acknowledgedBy   String?            @map("acknowledged_by")
  resolvedAt       DateTime?          @map("resolved_at")
  resolvedBy       String?            @map("resolved_by")
  resolutionNote   String?            @map("resolution_note")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  faculty Faculty? @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  bus     Bus?     @relation(fields: [busId], references: [id], onDelete: SetNull)
  route   Route?   @relation(fields: [routeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([studentId])
  @@index([facultyId])
  @@index([busId])
  @@index([routeId])
  @@index([status])
  @@index([priority])
  @@index([type])
  @@index([createdAt])
  @@map("emergency_alerts")
}

model Notification {
  id                  String              @id @default(uuid())
  userId              String              @map("user_id")
  type                NotificationType
  channel             NotificationChannel
  title               String
  message             String
  status              NotificationStatus  @default(PENDING)
  provider            String?
  providerMessageId   String?             @map("provider_message_id")
  errorCode           String?             @map("error_code")
  errorMessage        String?             @map("error_message")
  sentAt              DateTime?           @map("sent_at")
  deliveredAt         DateTime?           @map("delivered_at")
  readAt              DateTime?           @map("read_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
  @@map("notifications")
}

model TransportNotificationEvent {
  id           String                  @id @default(uuid())
  eventType    TransportEventType      @map("event_type")
  entityType   String                  @map("entity_type")
  entityId     String                  @map("entity_id")
  createdBy    String?                 @map("created_by")
  payload      Json
  idempotencyKey String?               @unique @map("idempotency_key")
  createdAt    DateTime                @default(now()) @map("created_at")

  @@index([eventType])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@index([idempotencyKey])
  @@map("transport_notification_events")
}

model TransportSchedule {
  id                  String         @id @default(uuid())
  busId               String         @map("bus_id")
  routeId             String         @map("route_id")
  tripType            TripType       @map("trip_type")
  departureTime       String         @map("departure_time")
  expectedArrivalTime String         @map("expected_arrival_time")
  effectiveFrom       DateTime       @map("effective_from")
  effectiveUntil      DateTime?      @map("effective_until")
  status              ScheduleStatus @default(ACTIVE)
  createdBy           String?        @map("created_by")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  bus       Bus              @relation(fields: [busId], references: [id], onDelete: Cascade)
  route     Route            @relation(fields: [routeId], references: [id], onDelete: Cascade)
  overrides ScheduleOverride[]

  @@index([busId])
  @@index([routeId])
  @@index([tripType])
  @@index([status])
  @@index([effectiveFrom])
  @@index([effectiveUntil])
  @@map("transport_schedules")
}

model ScheduleOverride {
  id                String                @id @default(uuid())
  scheduleId        String                @map("schedule_id")
  date              DateTime              @db.Date
  replacementBusId  String?               @map("replacement_bus_id")
  status            ScheduleOverrideStatus @default(SCHEDULED)
  reason            String?
  createdBy         String?               @map("created_by")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  schedule       TransportSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  replacementBus Bus?              @relation(fields: [replacementBusId], references: [id], onDelete: SetNull)

  @@unique([scheduleId, date])
  @@index([scheduleId])
  @@index([date])
  @@index([replacementBusId])
  @@index([status])
  @@map("schedule_overrides")
}
