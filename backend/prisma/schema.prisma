generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FACULTY
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ProfileStatus {
  ACTIVE
  INACTIVE
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum BusStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum AssignmentStatus {
  ACTIVE
  INACTIVE
}

enum TripType {
  MORNING
  EVENING
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         Role
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  lastLoginAt  DateTime?  @map("last_login_at")

  student  Student?
  faculty  Faculty?

  @@index([email])
  @@index([role])
  @@map("users")
}

model Student {
  id              String        @id @default(uuid())
  userId          String        @unique @map("user_id")
  registerNumber  String        @unique @map("register_number")
  name            String
  phone           String?
  department      String?
  year            String?
  section         String?
  gender          String?
  status          ProfileStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transportAssignment StudentBusAssignment?

  @@index([userId])
  @@index([registerNumber])
  @@index([name])
  @@index([department])
  @@map("students")
}

model Faculty {
  id          String        @id @default(uuid())
  userId      String        @unique @map("user_id")
  facultyId   String        @unique @map("faculty_id")
  name        String
  phone       String?
  department  String?
  designation String?
  status      ProfileStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transportAssignment FacultyBusAssignment?
  attendances         Attendance[]

  @@index([userId])
  @@index([facultyId])
  @@index([name])
  @@index([department])
  @@map("faculty")
}

model Driver {
  id              String       @id @default(uuid())
  driverCode      String       @unique @map("driver_code")
  name            String
  phone           String?
  alternatePhone  String?      @map("alternate_phone")
  licenseNumber   String       @unique @map("license_number")
  licenseExpiry   DateTime?    @map("license_expiry")
  experienceYears Int?         @map("experience_years")
  address         String?
  status          DriverStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  bus Bus?

  @@index([driverCode])
  @@index([name])
  @@index([phone])
  @@index([licenseNumber])
  @@map("drivers")
}

model Bus {
  id                 String     @id @default(uuid())
  busNumber          Int        @unique @map("bus_number")
  registrationNumber String     @unique @map("registration_number")
  capacity           Int        @default(60)
  boysCapacity       Int?       @map("boys_capacity")
  girlsCapacity      Int?       @map("girls_capacity")
  driverId           String?    @unique @map("driver_id")
  routeId            String?    @map("route_id")
  status             BusStatus  @default(ACTIVE)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  driver             Driver?                @relation(fields: [driverId], references: [id], onDelete: SetNull)
  route              Route?                 @relation(fields: [routeId], references: [id], onDelete: SetNull)
  studentAssignments StudentBusAssignment[]
  facultyAssignments FacultyBusAssignment[]
  attendances        Attendance[]

  @@index([busNumber])
  @@index([registrationNumber])
  @@index([driverId])
  @@index([routeId])
  @@index([status])
  @@map("buses")
}

model Route {
  id          String       @id @default(uuid())
  routeCode   String       @unique @map("route_code")
  routeName   String       @map("route_name")
  description String?
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  buses      Bus[]
  routeStops RouteStop[]

  @@index([routeCode])
  @@index([routeName])
  @@map("routes")
}

model BusStop {
  id        String       @id @default(uuid())
  stopCode  String       @unique @map("stop_code")
  name      String
  address   String?
  latitude  Float?
  longitude Float?
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  routeStops          RouteStop[]
  studentAssignments  StudentBusAssignment[]

  @@index([stopCode])
  @@index([name])
  @@map("bus_stops")
}

model RouteStop {
  id                    String   @id @default(uuid())
  routeId               String   @map("route_id")
  busStopId             String   @map("bus_stop_id")
  stopOrder             Int      @map("stop_order")
  estimatedArrivalTime  String?  @map("estimated_arrival_time")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  route   Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  busStop BusStop @relation(fields: [busStopId], references: [id], onDelete: Cascade)

  @@unique([routeId, busStopId])
  @@unique([routeId, stopOrder])
  @@index([routeId])
  @@index([busStopId])
  @@map("route_stops")
}

model StudentBusAssignment {
  id         String           @id @default(uuid())
  studentId  String           @unique @map("student_id")
  busId      String           @map("bus_id")
  busStopId  String           @map("bus_stop_id")
  startDate  DateTime         @default(now()) @map("start_date")
  endDate    DateTime?        @map("end_date")
  status     AssignmentStatus @default(ACTIVE)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bus     Bus     @relation(fields: [busId], references: [id], onDelete: Cascade)
  busStop BusStop @relation(fields: [busStopId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([busId])
  @@index([busStopId])
  @@index([status])
  @@map("student_bus_assignments")
}

model FacultyBusAssignment {
  id         String           @id @default(uuid())
  facultyId  String           @unique @map("faculty_id")
  busId      String           @map("bus_id")
  startDate  DateTime         @default(now()) @map("start_date")
  endDate    DateTime?        @map("end_date")
  status     AssignmentStatus @default(ACTIVE)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  bus     Bus     @relation(fields: [busId], references: [id], onDelete: Cascade)

  @@index([facultyId])
  @@index([busId])
  @@index([status])
  @@map("faculty_bus_assignments")
}

model Attendance {
  id         String   @id @default(uuid())
  busId      String   @map("bus_id")
  facultyId  String   @map("faculty_id")
  date       DateTime @map("date")
  tripType   TripType @map("trip_type")
  boysCount  Int      @default(0) @map("boys_count")
  girlsCount Int      @default(0) @map("girls_count")
  totalCount Int      @default(0) @map("total_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  bus    Bus    @relation(fields: [busId], references: [id], onDelete: Cascade)
  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([busId, date, tripType])
  @@index([busId])
  @@index([facultyId])
  @@index([date])
  @@index([tripType])
  @@map("attendance")
}
