# ─── Database ──────────────────────────────────────────
# Managed PostgreSQL connection string (use ?sslmode=require for cloud providers)
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/dtms_db?schema=public&sslmode=require"

# ─── Server ────────────────────────────────────────────
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-frontend.vercel.app

# ─── JWT Authentication ────────────────────────────────
# Generate strong random strings: openssl rand -base64 64
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Admin Seed (only used by `npx prisma db seed`) ───
ADMIN_EMAIL=admin@dtms.local
ADMIN_PASSWORD=

# ─── WhatsApp Cloud API ────────────────────────────────
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v18.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_ADMIN_PHONE_NUMBER=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ─── WhatsApp Message Templates ────────────────────────
WHATSAPP_TEMPLATE_EMERGENCY=emergency_alert
WHATSAPP_TEMPLATE_BUS_ASSIGNED=bus_assigned
WHATSAPP_TEMPLATE_BUS_SWAPPED=bus_swapped
WHATSAPP_TEMPLATE_BUS_REPLACED=bus_replaced
WHATSAPP_TEMPLATE_BUS_CANCELLED=bus_cancelled
WHATSAPP_TEMPLATE_ROUTE_CHANGED=route_changed
WHATSAPP_TEMPLATE_BUS_STOP_CHANGED=bus_stop_changed
WHATSAPP_TEMPLATE_TRANSPORT_ANNOUNCEMENT=transport_announcement
WHATSAPP_TEMPLATE_LANGUAGE=en
