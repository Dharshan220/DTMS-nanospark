DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/dtms_db?schema=public"
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:8080

# JWT Authentication Secrets
# Generate strong random strings for production. Never commit real values.
JWT_ACCESS_SECRET=your-access-token-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production

# Access token expiry (default: 15 minutes)
JWT_ACCESS_EXPIRY=15m
# Refresh token expiry (default: 7 days)
JWT_REFRESH_EXPIRY=7d

# Admin seed (only used by `npx prisma db seed`)
ADMIN_EMAIL=admin@dtms.local
ADMIN_PASSWORD=Admin@12345

# WhatsApp Cloud API Configuration
# Set to 'true' to enable real WhatsApp message delivery
WHATSAPP_ENABLED=false

# Meta WhatsApp Cloud API credentials
WHATSAPP_API_VERSION=v18.0
WHATSAPP_ACCESS_TOKEN=your-access-token-here
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_API_BASE_URL=https://graph.facebook.com

# Admin phone number for emergency SOS notifications
WHATSAPP_ADMIN_PHONE_NUMBER=+91XXXXXXXXXX

# WhatsApp Webhook Verification
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# WhatsApp Message Templates (must be approved in Meta Business)
WHATSAPP_TEMPLATE_EMERGENCY=emergency_alert
WHATSAPP_TEMPLATE_BUS_ASSIGNED=bus_assigned
WHATSAPP_TEMPLATE_BUS_SWAPPED=bus_swapped
WHATSAPP_TEMPLATE_BUS_REPLACED=bus_replaced
WHATSAPP_TEMPLATE_BUS_CANCELLED=bus_cancelled
WHATSAPP_TEMPLATE_ROUTE_CHANGED=route_changed
WHATSAPP_TEMPLATE_BUS_STOP_CHANGED=bus_stop_changed
WHATSAPP_TEMPLATE_TRANSPORT_ANNOUNCEMENT=transport_announcement

# WhatsApp Template Language
WHATSAPP_TEMPLATE_LANGUAGE=en
